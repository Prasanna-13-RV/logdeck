{
  "name": "logdeck",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first desktop log viewer",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "release": "node scripts/release.mts",
    "release:ci": "node scripts/release.mts --ci",
    "start": "electron .",
    "dev:website": "vite --config website/vite.config.mts",
    "build:website": "npm run typecheck && vite build --config website/vite.config.mts",
    "preview:website": "vite preview --config website/vite.config.mts --host 127.0.0.1 --port 5174",
    "test": "vitest run",
    "test:desktop": "playwright test",
    "test:website": "playwright test --config playwright.website.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-logdeck \"npm run test:rules:run\"",
    "test:rules:run": "vitest run --config vitest.rules.config.mts",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@streamparser/json": "0.0.26",
    "@tanstack/react-virtual": "3.13.12",
    "better-sqlite3": "13.0.3",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
