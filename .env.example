# Public Firebase web configuration only. Never put service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Optional legacy website-only override; Netlify normally uses GitHub release metadata.
VITE_WINDOWS_DOWNLOAD_URL=
# Existing website/download configuration; GitHub desktop checks use version-check.config.json.
# Development builds may leave these blank. npm run release uses release.config.json.
VITE_UPDATE_MANIFEST_URL=
VITE_WEBSITE_URL=
